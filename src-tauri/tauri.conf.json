{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuOrden",
  "version": "0.4.0",
  "identifier": "com.tuorden.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TuOrden POS",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "focus": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TuOrden",
    "copyright": "Copyright 2026 TuOrden",
    "shortDescription": "Punto de venta para pequenos negocios",
    "longDescription": "TuOrden POS: ventas, inventario, produccion, gastos, reportes y sincronizacion entre dispositivos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": ["es-ES", "en-US"]
      },
      "nsis": {
        "installMode": "both",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
